<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="auto">

    <!--
      Permissions are limited to what the launcher and the native engine
      actually use:
        * WAKE_LOCK / VIBRATE – SDL keeps the screen on and drives gamepad
          rumble through the Java Vibrator service.
        * BLUETOOTH_CONNECT (API 31+) and legacy BLUETOOTH (<= 30) – SDL
          controller support for Bluetooth gamepads.
        * READ_EXTERNAL_STORAGE / WRITE_EXTERNAL_STORAGE – only needed on
          API <= 32 to let the player pick a Vice City folder from shared
          storage; on 33+ the Storage Access Framework is used instead.
      The game has no networking, media-library, notification or recording
      features, so those permissions are intentionally absent.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Game files are imported via the system picker into app-owned storage;
         no MANAGE_EXTERNAL_STORAGE permission is needed. -->

    <!-- The GL3 backend links against GLESv3 and compiles ES 3.0 shaders. -->
    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true"/>

    <!-- Touchscreen support -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- Game controller support -->
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.gamepad"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <!-- No microphone: the engine never opens an input device. -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <supports-screens
        android:anyDensity="true"
        android:largeScreens="true"
        android:normalScreens="true"
        android:resizeable="false"
        android:smallScreens="true" />

    <application
        android:isGame="true"
        android:appCategory="game"
        android:resizeableActivity="false"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ReVC"
        tools:targetApi="31">

        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="false"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="org.libsdl.app.SDLActivity"
            android:alwaysRetainTaskState="true"
            android:hardwareAccelerated="true"
            android:largeHeap="true"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="false"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:preferMinimalPostProcessing="true"
            android:exported="false" />

        <meta-data
            android:name="android.max_aspect"
            android:value="2.6" />
    </application>

</manifest>
